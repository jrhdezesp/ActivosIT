{
    "name": "pinturasamericanas/activos-it",
    "description": "Sistema de gestión de activos de TI - base MVC en PHP",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1.6"
    },
    "autoload": {
        "psr-4": {
            "Controllers\\": "src/Controllers/",
            "Dao\\": "src/Dao/",
            "Utilities\\": "src/Utilities/",
            "Views\\": "src/Views/"
        }
    },
    "scripts": {
        "lint": "@php scripts/lint.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
